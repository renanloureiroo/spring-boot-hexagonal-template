spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/hexagonal_template
    username: hexagonal_template
    password: secret
  docker:
    compose:
      enabled: true
  jpa:
    show-sql: true

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true

logging:
  level:
    com.renanloureiroo.hexagonal: DEBUG
